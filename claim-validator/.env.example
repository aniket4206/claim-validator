# claim-validator configuration
# All settings use CLAIM_VALIDATOR_ prefix

# AI Provider Configuration (optional — rule-based works without these)
# CLAIM_VALIDATOR_AI_PROVIDER=anthropic
# CLAIM_VALIDATOR_AI_API_KEY=sk-ant-...
# CLAIM_VALIDATOR_AI_MODEL=claude-sonnet-4-5-20241022

# Pipeline Configuration
# CLAIM_VALIDATOR_SKIP_AI_ON_RULE_FAILURE=true

# Clearinghouse Configuration (optional — pick ONE provider)
# --- Waystar ---
# CLEARINGHOUSE_PROVIDER=waystar
# CLEARINGHOUSE_API_KEY=your-waystar-api-key          # HMAC key from Settings > Key/Pass
# CLEARINGHOUSE_SECRET=your-waystar-hmac-secret        # HMAC secret (defaults to API key)
# CLEARINGHOUSE_USER_ID=your-waystar-user-id           # UserID for eligibility/PA endpoints
# CLEARINGHOUSE_PASSWORD=your-waystar-password         # Password for eligibility/PA endpoints
# CLEARINGHOUSE_CUST_ID=your-waystar-customer-id       # Waystar Customer ID (integer)
# CLEARINGHOUSE_BASE_URL=https://claimsapi.zirmed.com  # Claims History service
# CLEARINGHOUSE_ELIGIBILITY_BASE_URL=https://eligibilityapi.zirmed.com
# CLEARINGHOUSE_PRIOR_AUTH_BASE_URL=https://priorauthorizationapi.waystar.com
#
# --- Stedi (Bearer token) ---
# CLEARINGHOUSE_PROVIDER=stedi
# CLEARINGHOUSE_API_KEY=your-stedi-api-key
# CLEARINGHOUSE_BASE_URL=https://healthcare.us.stedi.com
#
# --- Claim.MD (AccountKey) ---
# CLEARINGHOUSE_PROVIDER=claimmd
# CLEARINGHOUSE_API_KEY=your-claimmd-account-key
# CLEARINGHOUSE_BASE_URL=https://svc.claim.md
